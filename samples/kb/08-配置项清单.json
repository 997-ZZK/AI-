{
  "title": "关键配置项清单",
  "note": "生产部署前逐项确认；带 env 前缀的值只从环境变量读取",
  "items": [
    { "key": "aiflow.provider.order", "default": "local,cloud,mock", "meaning": "档位优先级，越靠前越先用" },
    { "key": "aiflow.provider.probe-interval-ms", "default": 15000, "meaning": "探活周期，探活结果决定档位是否可用" },
    { "key": "aiflow.retrieval.min-score", "default": 0.35, "meaning": "全局检索阈值，仅服务 mock 量纲" },
    { "key": "aiflow.retrieval.embedding.min-score", "default": -1, "meaning": "向量档专用阈值，-1 表示继承全局；bge-m3 校准值 0.55" },
    { "key": "aiflow.retrieval.embedding.mode", "value": "mock|http", "meaning": "mock 为离线演示，http 为真实向量服务" },
    { "key": "aiflow.tools.enabled", "default": false, "meaning": "工具调用总开关，打开即允许引擎主动出网" },
    { "key": "aiflow.safety.enabled", "default": true, "meaning": "内容安全审核，输入侧拦在入库前，输出侧拦在返回前" },
    { "key": "aiflow.budget.enabled", "default": true, "meaning": "每用户 token 额度，自然日口径" },
    { "key": "aiflow.engine.session-queue-capacity", "default": 1000, "meaning": "同会话排队上限，满则返回 429" }
  ]
}