{
  "id": "basic-chat",
  "name": "basic-chat",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "开始"
    },
    {
      "id": "llm",
      "type": "llm.chat",
      "name": "对话",
      "requires": ["chat"],
      "params": {
        "prompt": "${input}",
        "fallback": "抱歉，当前无法连接模型服务，请稍后再试。"
      },
      "retry": {
        "maxAttempts": 2,
        "backoffMillis": 300
      },
      "timeoutSeconds": 60
    },
    {
      "id": "end",
      "type": "end",
      "name": "结束",
      "params": {
        "outputs": {
          "reply": "reply",
          "fallback": "fallback"
        }
      }
    }
  ],
  "edges": [
    {"from": "start", "to": "llm"},
    {"from": "llm", "to": "end"}
  ]
}
